{
  "name": "anandnarasipuram",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/* runs the Worker first; everything else is served from ./public as before (incl. _redirects).
    "run_worker_first": ["/api/*"]
  },
  // content/content.md is imported into the Worker as a string.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // 10 questions per 60 s per IP. The Cohere dashboard spend limit is the hard cost cap.
  "ratelimits": [{ "name": "ASK_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
}
